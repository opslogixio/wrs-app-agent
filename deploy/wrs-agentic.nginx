limit_req_zone $binary_remote_addr zone=wrs_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name wrs.opslogix.io wrs-agentic 54.166.216.124;
    client_max_body_size 20M;

    # Never serve uploaded claims or reports as public static assets.
    location ~* ^/(?:static/)?(?:upload|daily-report-pdf)(?:/|$) {
        return 404;
    }

    location ~ /\.(?!well-known/) {
        return 404;
    }

    location = /accounts/login/ {
        limit_req zone=wrs_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static/ {
        alias /var/lib/wrs-app/staticfiles/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
