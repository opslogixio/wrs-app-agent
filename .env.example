# Export in your shell, or use /etc/wrs-app/wrs-app.env with systemd.
# Django does not load this file automatically.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=wrs-agentic,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://wrs-agentic
DB_NAME=wrs_app
DB_USER=wrs_app
DB_HOST=127.0.0.1
DB_PORT=3306
DB_PASSWORD=
DJANGO_STATIC_ROOT=/var/lib/wrs-app/staticfiles
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_PASSWORD=
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
