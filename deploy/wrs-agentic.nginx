limit_req_zone $binary_remote_addr zone=wrs_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name wrs.opslogix.io wrs-agentic 54.166.216.124;
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://wrs.opslogix.io$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name wrs.opslogix.io;
    ssl_certificate /etc/letsencrypt/live/wrs.opslogix.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wrs.opslogix.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    proxy_hide_header Strict-Transport-Security;
    client_max_body_size 20M;

    # Never serve uploaded claims or reports as public static assets.
    location ~* ^/(?:static/)?(?:upload|daily-report-pdf)(?:/|$) {
        return 404;
    }

    location ~ /\.(?!well-known/) {
        return 404;
    }

    location = /accounts/login/ {
        limit_req zone=wrs_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static/ {
        alias /var/lib/wrs-app/staticfiles/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
